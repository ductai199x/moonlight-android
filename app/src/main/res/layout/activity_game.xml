<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <TextView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="left"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:gravity="left"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/quickMenuHandle"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="10dp"
        android:padding="6dp"
        android:background="@drawable/quick_menu_bg"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/quickMenuHandleChevron"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_chevron_left"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_open_description" />

        <ImageButton
            android:id="@+id/quickMenuHandleKeyboard"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="9dp"
            android:focusable="false"
            android:src="@drawable/ic_keyboard"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_keyboard_description" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/quickMenu"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginTop="180dp"
        android:layout_marginEnd="10dp"
        android:padding="4dp"
        android:background="@drawable/quick_menu_bg"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/quickMenuZoomButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_pan_zoom"
            android:background="@android:color/transparent"
            android:contentDescription="@string/pan_zoom_toggle_description" />

        <ImageButton
            android:id="@+id/quickMenuKeyboardButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_keyboard"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_keyboard_description" />

        <ImageButton
            android:id="@+id/quickMenuCursorModeButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_mouse"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_cursor_mode_description" />

        <ImageButton
            android:id="@+id/quickMenuQualityButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_tune"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_quality_description" />

        <ImageButton
            android:id="@+id/quickMenuDisconnectButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_power"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_disconnect_description" />

        <ImageButton
            android:id="@+id/quickMenuCollapseButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:focusable="false"
            android:src="@drawable/ic_chevron_right"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_close_description" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mouseButtonBar"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="20dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/mouseLeftButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginEnd="20dp"
            android:padding="12dp"
            android:focusable="false"
            android:src="@drawable/ic_mouse_left"
            android:background="@drawable/quick_menu_bg"
            android:contentDescription="@string/mouse_left_button_description" />

        <ImageButton
            android:id="@+id/mouseRightButton"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:padding="12dp"
            android:focusable="false"
            android:src="@drawable/ic_mouse_right"
            android:background="@drawable/quick_menu_bg"
            android:contentDescription="@string/mouse_right_button_description" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/scrollStrip"
        android:layout_width="36dp"
        android:layout_height="170dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_scroll_ridges"
        android:scaleType="center"
        android:focusable="false"
        android:background="@drawable/scroll_wheel_bg"
        android:contentDescription="@string/scroll_strip_description"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/modifierBar"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:layout_gravity="bottom"
        android:gravity="center_vertical"
        android:paddingStart="8dp"
        android:paddingEnd="8dp"
        android:background="#F2262B33"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/modifierWinButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="12dp"
            android:focusable="false"
            android:src="@drawable/ic_windows"
            android:background="@android:color/transparent"
            android:contentDescription="@string/modifier_win_description" />

        <Button
            android:id="@+id/modifierShiftButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:text="@string/modifier_shift"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#EEEEEE"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/modifierCtrlButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:text="@string/modifier_ctrl"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#EEEEEE"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/modifierAltButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:text="@string/modifier_alt"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#EEEEEE"
            android:background="@android:color/transparent" />

        <Button
            android:id="@+id/modifierCapsButton"
            android:layout_width="wrap_content"
            android:layout_height="44dp"
            android:minWidth="0dp"
            android:minHeight="0dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:focusable="false"
            android:text="@string/modifier_caps"
            android:textSize="16sp"
            android:textAllCaps="false"
            android:textColor="#EEEEEE"
            android:background="@android:color/transparent" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <ImageButton
            android:id="@+id/modifierSettingsButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:focusable="false"
            android:src="@drawable/ic_settings"
            android:tint="#EEEEEE"
            android:scaleType="fitCenter"
            android:background="@android:color/transparent"
            android:contentDescription="@string/modifier_settings_description" />

        <ImageButton
            android:id="@+id/modifierPadToggleButton"
            android:layout_width="48dp"
            android:layout_height="44dp"
            android:padding="11dp"
            android:focusable="false"
            android:src="@drawable/ic_keyboard"
            android:background="@android:color/transparent"
            android:contentDescription="@string/modifier_pad_toggle_description" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/functionPad"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="300dp"
        android:layout_gravity="bottom"
        android:padding="4dp"
        android:background="#F21C2028"
        android:visibility="gone">

        <LinearLayout style="@style/FunctionPadRow">
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF1" android:text="F1" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF2" android:text="F2" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF3" android:text="F3" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF4" android:text="F4" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcEsc" android:text="Esc" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcPrScr" android:text="PrScr" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcHome" android:text="Home" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcPgUp" android:text="Pg Up" />
        </LinearLayout>

        <LinearLayout style="@style/FunctionPadRow">
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF5" android:text="F5" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF6" android:text="F6" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF7" android:text="F7" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF8" android:text="F8" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcTab" android:text="Tab" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcDel" android:text="Del" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcEnd" android:text="End" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcPgDn" android:text="Pg Dn" />
        </LinearLayout>

        <LinearLayout style="@style/FunctionPadRow">
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF9" android:text="F9" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF10" android:text="F10" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF11" android:text="F11" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcF12" android:text="F12" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcIns" android:text="Ins" />
            <View style="@style/FunctionPadSpacer" />
            <View style="@style/FunctionPadSpacer" />
            <View style="@style/FunctionPadSpacer" />
        </LinearLayout>

        <LinearLayout style="@style/FunctionPadRow">
            <Button style="@style/FunctionPadKey" android:id="@+id/funcCtrlZ" android:text="Ctrl+Z" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcWinD" android:text="Win+D" />
            <ImageButton style="@style/FunctionPadKey" android:id="@+id/funcLock"
                android:src="@drawable/ic_lock" android:scaleType="fitCenter" android:padding="12dp"
                android:contentDescription="@string/func_lock_description" />
            <ImageButton style="@style/FunctionPadKey" android:id="@+id/funcRotate"
                android:src="@drawable/ic_screen_rotate" android:scaleType="fitCenter" android:padding="12dp"
                android:contentDescription="@string/func_rotate_description" />
            <View style="@style/FunctionPadSpacer" />
            <View style="@style/FunctionPadSpacer" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcUp" android:text="▲" />
            <View style="@style/FunctionPadSpacer" />
        </LinearLayout>

        <LinearLayout style="@style/FunctionPadRow">
            <Button style="@style/FunctionPadKey" android:id="@+id/funcCtrlC" android:text="Ctrl-C" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcCtrlX" android:text="Ctrl-X" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcCtrlV" android:text="Ctrl-V" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcCtrlA" android:text="Ctrl+A" />
            <View style="@style/FunctionPadSpacer" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcLeft" android:text="◄" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcDown" android:text="▼" />
            <Button style="@style/FunctionPadKey" android:id="@+id/funcRight" android:text="►" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="right"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

</merge>
