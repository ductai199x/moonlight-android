<merge xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Game" >

    <View
        android:id="@+id/backgroundTouchView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center" />

    <com.limelight.ui.StreamView
        android:id="@+id/surfaceView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:focusable="true"
        android:focusableInTouchMode="true"
        android:focusedByDefault="true"
        android:defaultFocusHighlightEnabled="false">
        <requestFocus />
    </com.limelight.ui.StreamView>

    <TextView
        android:id="@+id/performanceOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="left"
        android:textAppearance="?android:attr/textAppearanceSmall"
        android:gravity="left"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/panZoomToggleButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:layout_gravity="top|center_horizontal"
        android:layout_marginTop="10dp"
        android:padding="10dp"
        android:src="@drawable/ic_pan_zoom"
        android:background="@drawable/pan_zoom_button_bg"
        android:contentDescription="@string/pan_zoom_toggle_description"
        android:visibility="gone" />

    <ImageButton
        android:id="@+id/quickMenuHandle"
        android:layout_width="40dp"
        android:layout_height="56dp"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:padding="8dp"
        android:src="@drawable/ic_chevron_left"
        android:background="@drawable/quick_menu_bg"
        android:contentDescription="@string/quick_menu_open_description"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/quickMenu"
        android:orientation="vertical"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end|center_vertical"
        android:layout_marginEnd="8dp"
        android:padding="4dp"
        android:background="@drawable/quick_menu_bg"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/quickMenuCollapseButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_chevron_right"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_close_description" />

        <ImageButton
            android:id="@+id/quickMenuKeyboardButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_keyboard"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_keyboard_description" />

        <ImageButton
            android:id="@+id/quickMenuCursorModeButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_mouse"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_cursor_mode_description" />

        <ImageButton
            android:id="@+id/quickMenuDisconnectButton"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:padding="10dp"
            android:src="@drawable/ic_power"
            android:background="@android:color/transparent"
            android:contentDescription="@string/quick_menu_disconnect_description" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/mouseButtonBar"
        android:orientation="horizontal"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|center_horizontal"
        android:layout_marginBottom="24dp"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/mouseLeftButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:layout_marginEnd="16dp"
            android:padding="10dp"
            android:src="@drawable/ic_mouse_left"
            android:background="@drawable/quick_menu_bg"
            android:contentDescription="@string/mouse_left_button_description" />

        <ImageButton
            android:id="@+id/mouseRightButton"
            android:layout_width="56dp"
            android:layout_height="48dp"
            android:padding="10dp"
            android:src="@drawable/ic_mouse_right"
            android:background="@drawable/quick_menu_bg"
            android:contentDescription="@string/mouse_right_button_description" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/scrollStrip"
        android:layout_width="40dp"
        android:layout_height="180dp"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="8dp"
        android:layout_marginBottom="120dp"
        android:src="@drawable/ic_scroll"
        android:scaleType="center"
        android:background="@drawable/quick_menu_bg"
        android:contentDescription="@string/scroll_strip_description"
        android:visibility="gone" />

    <TextView
        android:id="@+id/notificationOverlay"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginRight="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="10dp"
        android:layout_gravity="right"
        android:textAppearance="?android:attr/textAppearanceLarge"
        android:gravity="right"
        android:background="#80000000"
        android:preferKeepClear="true"
        android:visibility="gone" />

</merge>
